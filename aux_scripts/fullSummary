# ----------------- Timing analysis -----------------
def read_timings(workdir):
    """
    Parse logs/timings.csv and return dict of stats per stage:
      { stage: {count, avg_sec, min_sec, max_sec, ok, fail, skipped} }
    """
    csv_path = os.path.join(workdir, 'logs', 'timings.csv')
    if not os.path.exists(csv_path):
        return {}

    stats = defaultdict(lambda: {'durations': [], 'ok': 0, 'fail': 0, 'skipped': 0})
    try:
        with open(csv_path) as f:
            next(f, None)  # skip header
            for line in f:
                parts = line.strip().split(',')
                if len(parts) < 5:
                    continue
                jobid, taskid, stage, duration, status = parts[:5]
                try:
                    dur = int(duration)
                except ValueError:
                    continue
                if status == 'OK':
                    stats[stage]['durations'].append(dur)
                    stats[stage]['ok'] += 1
                elif status == 'FAIL':
                    stats[stage]['fail'] += 1
                elif status == 'skipped':
                    stats[stage]['skipped'] += 1
    except Exception as e:
        return {}

    result = {}
    for stage, info in stats.items():
        durs = info['durations']
        result[stage] = {
            'count': len(durs),
            'avg': sum(durs) / len(durs) if durs else 0,
            'min': min(durs) if durs else 0,
            'max': max(durs) if durs else 0,
            'ok': info['ok'],
            'fail': info['fail'],
            'skipped': info['skipped'],
        }
    return result


def fmt_seconds(sec):
    """Format seconds into H:MM:SS or M:SS."""
    sec = int(sec)
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    if h:
        return f"{h}:{m:02d}:{s:02d}"
    return f"{m}:{s:02d}"


_REAL_ERROR_RE = re.compile(
    r'\b(SEVERE|ERROR|FATAL|Traceback|Segmentation fault|core dumped|'
    r'srun: error|sbatch: error|killed|abort)\b',
    re.IGNORECASE,
)


def _classify_err_file(err_file):
    """Inspect an .err file. Returns 'error' if it has real failure markers,
    'warn' if it only has WARN/Warning lines, None if it's empty or trivial."""
    try:
        size = os.path.getsize(err_file)
    except OSError:
        return None
    if size < 50:
        return None
    try:
        with open(err_file, 'r', errors='replace') as f:
            content = f.read(50000)  # cap
    except OSError:
        return None
    if _REAL_ERROR_RE.search(content):
        return 'error'
    if 'WARN' in content or 'Warning' in content or 'warning' in content:
        return 'warn'
    # Has content but doesn't match either pattern: treat as warning to surface,
    # but don't escalate to error.
    return 'warn'


def collect_errors(workdir):
    """Walk error subdirectories and the logs/ folder for failures.
    Returns (errors, warnings) - two dicts mapping stage -> list of file paths.
    """
    errors_dir = os.path.join(workdir, 'errors')
    logs_dir = os.path.join(workdir, 'logs')

    by_stage = defaultdict(list)
    warnings_by_stage = defaultdict(list)

    # Organised errors directory: assume the user already triaged anything in here.
    if os.path.isdir(errors_dir):
        for stage in os.listdir(errors_dir):
            stage_path = os.path.join(errors_dir, stage)
            if os.path.isdir(stage_path):
                for err_file in glob.glob(os.path.join(stage_path, '*')):
                    by_stage[stage].append(err_file)

    # Slurm .err files in logs/ - inspect content to separate real errors from warnings.
    if os.path.isdir(logs_dir):
        for err_file in glob.glob(os.path.join(logs_dir, '*.err')):
            kind = _classify_err_file(err_file)
            if kind is None:
                continue
            base = os.path.basename(err_file).lower()
            if 'rmsy' in base:
                stage = 'rmsynth/rmclean'
            elif 'merge' in base:
                stage = 'merge'
            elif 'orchestrate' in base:
                stage = 'orchestrator'
            else:
                stage = 'unknown'
            if kind == 'error':
                by_stage[stage].append(err_file)
            else:
                warnings_by_stage[stage].append(err_file)

    return dict(by_stage), dict(warnings_by_stage)


# ----------------- Display -----------------
def _render_progress_block(label, workdir, total_chunks, cancelled):
    """Print one region's (or the single-cube workdir's) full progress block:
    stage bars + output files + per-stage timings + errors.

    SLURM-wide things (active jobs table) are rendered ONCE by display_summary,
    not per-region, since SLURM state is global to the user.
    """
    # Show the path relative to the user's CWD ('./region1' instead of the
    # full absolute path), since fullSummary is typically run from the
    # top-level workdir and the region subdirs live right next to it.
    rel = os.path.relpath(workdir)
    display_path = rel if rel == '.' else './' + rel
    print(f"{C.BOLD}{C.CYAN}━━━ {label} ━━━{C.END}  ({display_path})")

    def stage_colour(stage):
        return C.YELLOW if stage in cancelled else C.CYAN

    extract_done, extract_total = count_extraction(workdir)
    print(f"  {stage_colour('extract')}{bar(extract_done, extract_total, label='Extraction')}"
          f"{' (CANCELLED)' if 'extract' in cancelled else ''}{C.END}")

    noise_done, noise_total = count_noise(workdir)
    print(f"  {stage_colour('noise')}{bar(noise_done, noise_total, label='Noise map')}"
          f"{' (CANCELLED)' if 'noise' in cancelled else ''}{C.END}")

    timings = read_timings(workdir)

    # rmsynth (FDF_tot_dirty) and rmclean (FDF_clean_tot) outputs don't get
    # cleaned up, so their on-disk counts are honest.
    rmsynth = count_rmsynth(workdir)
    rmclean = count_rmclean(workdir)

    # Chunks (Q/U .fits) ARE deleted as soon as the same task's rmclean
    # finishes, so a naive count under-reports. Pin the bar to the highest
    # of: chunks still on disk, the chunking row in timings.csv, the rmsynth
    # count (rmsynth can't have run without chunking), and rmclean count.
    chunked = max(
        count_chunked_inputs(workdir),
        timings.get('chunking', {}).get('ok', 0) + timings.get('chunking', {}).get('skipped', 0),
        rmsynth,
        rmclean,
    )
    print(f"  {stage_colour('chunking')}{bar(chunked, total_chunks, label='Chunking')}"
          f"{' (CANCELLED)' if 'chunking' in cancelled else ''}{C.END}")

    print(f"  {stage_colour('rmsynth')}{bar(rmsynth, total_chunks, label='RM Synthesis')}"
          f"{' (CANCELLED)' if 'rmsynth' in cancelled else ''}{C.END}")

    print(f"  {stage_colour('rmclean')}{bar(rmclean, total_chunks, label='RM Clean')}"
          f"{' (CANCELLED)' if 'rmclean' in cancelled else ''}{C.END}")

    # Merged outputs exist even when merge FAILED (make_empty_image runs first),
    # so a 15/15 bar can be entirely misleading. Cross-check timings.csv and
    # paint the bar red when any merge tasks failed.
    merged_count, merged_total, merged_files = count_merged(workdir)
    merge_fail = timings.get('merge', {}).get('fail', 0)
    merge_ok = timings.get('merge', {}).get('ok', 0)
    if merge_fail and merge_ok == 0:
        merge_colour = C.RED
        merge_suffix = f' (all {merge_fail} merge tasks FAILED -- outputs are wrong size)'
    elif merge_fail:
        merge_colour = C.YELLOW
        merge_suffix = f' ({merge_fail} merge task(s) failed -- check errors)'
    elif 'merge' in cancelled:
        merge_colour = C.YELLOW
        merge_suffix = ' (CANCELLED)'
    else:
        merge_colour = stage_colour('merge')
        merge_suffix = ''
    print(f"  {merge_colour}{bar(merged_count, merged_total, label='Merging')}"
          f"{merge_suffix}{C.END}")
    return merged_files


def display_summary(workdir, show_errors=False, verbose=False):
    """Display the pipeline summary.

    Auto-detects multi-region runs (workdir contains region<N>/ subdirs) and
    renders one progress block per region. Single-cube runs render one block
    against the top-level workdir as before.
    """
    print(f"{C.BOLD}{C.CYAN}")
    print("=" * 70)
    print("  processRM Pipeline Status ")
    print("  RM-synthesis made simple")
    print("=" * 70)
    print(f"{C.END}")
    print(f"  Workdir:    {workdir}")
    print(f"  Timestamp:  {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print()

    total_chunks = read_chunks_from_config(workdir)
    cancelled = cancelled_stages_from_sacct()
    regions = discover_regions(workdir)

    # Per-region or single-cube progress blocks
    region_dirs = [
        (f"Region {idx}" + (f" ({label})" if label else ""), path)
        for idx, path, label in regions
    ] if regions else [("PIPELINE STAGES", workdir)]
    all_merged = []
    for label, region_path in region_dirs:
        merged_files = _render_progress_block(label, region_path, total_chunks, cancelled)
        all_merged.append((label, region_path, merged_files))
        print()

    # SLURM jobs
    print(f"{C.BOLD}━━━ ACTIVE SLURM JOBS ━━━{C.END}")
    jobs = squeue_for_user()
    relevant_jobs = [j for j in jobs if any(k in j['name'].lower()
                                             for k in ['noise', 'rmsy', 'merge', 'cube',
                                                       'orchestrate'])]

    if not relevant_jobs:
        print(f"  {C.GREY}No active SLURM jobs found.{C.END}")
    elif verbose:
        print(f"  {'JOBID':<12} {'NAME':<20} {'STATE':<10} {'TIME':<10} "
              f"{'TIMELIMIT':<10} {'MEM':<8}")
        print(f"  {'-'*12} {'-'*20} {'-'*10} {'-'*10} {'-'*10} {'-'*8}")
        for j in relevant_jobs:
            color = C.GREEN if j['state'] == 'RUNNING' else (
                C.YELLOW if j['state'] == 'PENDING' else C.RED
            )
            print(f"  {color}{j['jobid']:<12} {j['name']:<20} "
                  f"{j['state']:<10} {j['time']:<10} {j['timelimit']:<10} "
                  f"{j['mem']:<8}{C.END}")
    else:
        # Compact summary: group by (name, state), report counts + a sample TIME
        from collections import Counter
        by_key = Counter()
        sample_time = {}
        for j in relevant_jobs:
            key = (j['name'], j['state'])
            by_key[key] += 1
            sample_time.setdefault(key, j['time'])
        print(f"  {'NAME':<20} {'STATE':<10} {'COUNT':<7} {'~TIME':<10}")
        print(f"  {'-'*20} {'-'*10} {'-'*7} {'-'*10}")
        for (name, state), count in sorted(by_key.items()):
            color = C.GREEN if state == 'RUNNING' else (
                C.YELLOW if state == 'PENDING' else C.RED
            )
            print(f"  {color}{name:<20} {state:<10} {count:<7} "
                  f"{sample_time[(name, state)]:<10}{C.END}")
        print(f"  {C.GREY}(use -v / --verbose for the full per-task table){C.END}")
    print()

    # Output files (per region when applicable)
    print(f"{C.BOLD}━━━ OUTPUT FILES ━━━{C.END}")
    any_files = False
    for label, region_path, merged_files in all_merged:
        if not merged_files:
            continue
        any_files = True
        if regions:
            print(f"  {C.BOLD}{label}{C.END}")
        for f in merged_files:
            full_path = os.path.join(region_path, f)
            size_mb = os.path.getsize(full_path) / (1024 * 1024)
            print(f"    {C.GREEN}✓{C.END} {f} ({size_mb:.1f} MB)")
    if not any_files:
        print(f"  {C.GREY}No merged output files yet.{C.END}")
    print()

    # Timing analysis (per region when applicable)
    print(f"{C.BOLD}━━━ PER-STAGE TIMINGS ━━━{C.END}")
    any_timings = False
    for label, region_path in (region_dirs if regions else [(None, workdir)]):
        timings = read_timings(region_path)
        if not timings:
            continue
        any_timings = True
        if regions:
            print(f"  {C.BOLD}{label}{C.END}")
        print(f"  {'STAGE':<10} {'COUNT':<7} {'AVG':<10} {'MIN':<10} {'MAX':<10} "
              f"{'OK':<5} {'FAIL':<5} {'SKIP':<5}")
        print(f"  {'-'*10} {'-'*7} {'-'*10} {'-'*10} {'-'*10} {'-'*5} {'-'*5} {'-'*5}")
        for stage in ['chunking', 'rmsynth', 'rmclean', 'merge']:
            if stage in timings:
                t = timings[stage]
                color = C.GREEN if t['fail'] == 0 else C.YELLOW
                print(f"  {color}{stage:<10} {t['count']:<7} "
                      f"{fmt_seconds(t['avg']):<10} {fmt_seconds(t['min']):<10} "
                      f"{fmt_seconds(t['max']):<10} {t['ok']:<5} {t['fail']:<5} "
                      f"{t['skipped']:<5}{C.END}")
    if not any_timings:
        print(f"  {C.GREY}No timing log yet (logs/timings.csv not found).{C.END}")
    print()

    # Errors / Warnings (per region when applicable)
    print(f"{C.BOLD}━━━ ERROR SUMMARY ━━━{C.END}")
    errors, warnings = {}, {}
    for _, region_path in (region_dirs if regions else [(None, workdir)]):
        e, w = collect_errors(region_path)
        for stage, files in e.items():
            errors.setdefault(stage, []).extend(files)
        for stage, files in w.items():
            warnings.setdefault(stage, []).extend(files)

    if not errors and not warnings:
        print(f"  {C.GREEN}No errors or warnings detected.{C.END}")
    else:
        if not errors:
            print(f"  {C.GREEN}No errors detected.{C.END}")
        for stage, err_files in errors.items():
            print(f"  {C.RED}[ERROR] [{stage}]{C.END} {len(err_files)} file(s)")
            if show_errors:
                for ef in err_files[:5]:
                    print(f"     - {ef}")
                if len(err_files) > 5:
                    print(f"     ... and {len(err_files) - 5} more")
        for stage, warn_files in warnings.items():
            print(f"  {C.YELLOW}[WARN]  [{stage}]{C.END} {len(warn_files)} file(s)")
            if show_errors:
                for wf in warn_files[:3]:
                    print(f"     - {wf}")
                if len(warn_files) > 3:
                    print(f"     ... and {len(warn_files) - 3} more")
    print()

    if not show_errors and (any(errors.values()) or any(warnings.values())):
        print(f"  {C.GREY}Run with --errors for full details.{C.END}")
    print()


def main():
    parser = argparse.ArgumentParser(
        description="fullSummary - processRM Pipeline Status Monitor"
    )
    parser.add_argument('--watch', action='store_true',
                        help='Continuously refresh every 10 seconds')
    parser.add_argument('-v', '--verbose', action='store_true',
                        help='Show the full per-task SLURM jobs table '
                             '(default shows a compact COUNT summary).')
    parser.add_argument('--errors', action='store_true',
                        help='Show full error details')
    parser.add_argument('--workdir', default=None,
                        help='Pipeline working directory (defaults to current dir)')
    parser.add_argument('--interval', type=int, default=10,
                        help='Refresh interval in seconds (default: 10)')

    args = parser.parse_args()
    workdir = os.path.abspath(args.workdir) if args.workdir else os.getcwd()

    if not os.path.exists(workdir):
        print(f"{C.RED}ERROR: workdir not found: {workdir}{C.END}")
        sys.exit(1)

    if args.watch:
        # Exit the watch loop as soon as there are no processRM-related SLURM
        # jobs in the queue -- otherwise --watch hangs indefinitely on a static
        # screen once the pipeline finishes.
        try:
            while True:
                os.system('clear')
                display_summary(workdir, show_errors=args.errors, verbose=args.verbose)
                jobs = squeue_for_user()
                relevant = [
                    j for j in jobs
                    if any(k in j['name'].lower()
                           for k in ('noise', 'rmsy', 'merge', 'cube', 'orchestrate'))
                ]
                if not relevant:
                    print(f"{C.GREY}No active processRM jobs. Exiting --watch.{C.END}")
                    break
                time.sleep(args.interval)
        except KeyboardInterrupt:
            print(f"\n{C.GREY}fullSummary stopped.{C.END}")
    else:
        display_summary(workdir, show_errors=args.errors, verbose=args.verbose)


if __name__ == '__main__':
    main()
