#!/usr/bin/env python3
"""
==================================================================
  fullSummary - processRM Pipeline Status Monitor
  RM-synthesis made simple
==================================================================

Displays the current state of an active processRM pipeline:
  - Per-stage progress bars (extraction / RM synthesis / RM clean / merge)
  - SLURM job IDs and their status (PENDING / RUNNING / COMPLETED / FAILED)
  - Memory usage per running job
  - Error summary (categorised by stage)
  - List of output files generated so far

Usage:
  ./fullSummary             # one-shot report (compact SLURM summary)
  ./fullSummary -v          # full per-task SLURM jobs table
  ./fullSummary --watch     # refresh every 10 seconds
  ./fullSummary --errors    # show full error details
"""

import os
import sys
import subprocess
import argparse
import glob
import time
import re
from datetime import datetime
from collections import defaultdict

# ----------------- Cosmetic helpers -----------------
class C:
    HEADER = '\033[95m'
    BLUE = '\033[94m'
    CYAN = '\033[96m'
    GREEN = '\033[92m'
    YELLOW = '\033[93m'
    RED = '\033[91m'
    BOLD = '\033[1m'
    END = '\033[0m'
    GREY = '\033[90m'


def bar(done, total, width=40, label=""):
    """Render a tqdm-like static progress bar."""
    if total == 0:
        pct = 0
    else:
        pct = done / total
    filled = int(pct * width)
    bar_str = '█' * filled + '░' * (width - filled)
    return f"{label:<14} [{bar_str}] {done}/{total} ({pct*100:5.1f}%)"


# ----------------- SLURM helpers -----------------
def squeue_for_user():
    """Get current SLURM jobs for the user."""
    user = os.environ.get('USER', 'amani')
    try:
        result = subprocess.run(
            ['squeue', '-u', user, '--format=%i|%j|%T|%M|%l|%R|%m'],
            capture_output=True, text=True, timeout=15
        )
        if result.returncode != 0:
            return []
        lines = result.stdout.strip().split('\n')[1:]
        jobs = []
        for line in lines:
            parts = line.split('|')
            if len(parts) >= 7:
                jobs.append({
                    'jobid': parts[0].strip(),
                    'name': parts[1].strip(),
                    'state': parts[2].strip(),
                    'time': parts[3].strip(),
                    'timelimit': parts[4].strip(),
                    'reason': parts[5].strip(),
                    'mem': parts[6].strip(),
                })
        return jobs
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return []


def sacct_for_job(jobid):
    """Get sacct info for a specific job (memory usage etc.)."""
    try:
        result = subprocess.run(
            ['sacct', '-j', jobid, '--format=JobID,State,MaxRSS,Elapsed',
             '--noheader', '--parsable2'],
            capture_output=True, text=True, timeout=15
        )
        if result.returncode != 0:
            return None
        return result.stdout.strip()
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return None


def cancelled_stages_from_sacct():
    """Return the set of pipeline stage names whose most recent SLURM job
    was CANCELLED and that have nothing actively running.

    A stage with running tasks RIGHT NOW overrides a historical CANCELLED.
    Only the LATEST entry per job name (by JobID) is considered, so an old
    cancelled run from yesterday doesn't paint today's healthy run orange.
    """
    cancelled = set()

    # Step 1: collect job-name prefixes that have anything active right now
    active_names = {j['name'].split('_')[0] for j in squeue_for_user()}

    # Step 2: walk last 24h of sacct, keeping only the LATEST state per name
    latest_state = {}
    try:
        result = subprocess.run(
            ['sacct', '--starttime=now-1days', '-X',
             '--format=JobID,JobName%30,State%20',
             '--noheader', '--parsable2'],
            capture_output=True, text=True, timeout=20
        )
        if result.returncode != 0:
            return cancelled
        rows = []
        for line in result.stdout.strip().splitlines():
            parts = line.split('|')
            if len(parts) < 3:
                continue
            jobid_field = parts[0].strip()
            try:
                # Use the numeric prefix of the job ID for ordering (handles 12345_3)
                jobid_num = int(jobid_field.split('_')[0].split('.')[0])
            except ValueError:
                continue
            name = parts[1].strip()
            state = parts[2].strip().split()[0]
            rows.append((jobid_num, name, state))
        # Newest first; only keep the first state we see for each name
        rows.sort(key=lambda r: r[0], reverse=True)
        for _, name, state in rows:
            latest_state.setdefault(name, state)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        pass

    for name, state in latest_state.items():
        if state != 'CANCELLED':
            continue
        # Skip if a job with this name is active again — fresh run started
        if name in active_names or any(name in a or a in name for a in active_names):
            continue
        n = name.lower()
        if 'orchestrate' in n:
            cancelled.update({'extract'})
        if n.startswith('rmsy'):
            cancelled.update({'chunking', 'rmsynth', 'rmclean'})
        if 'merge' in n:
            cancelled.add('merge')
    return cancelled


# ----------------- Stage analysis -----------------
def count_extraction(workdir):
    """How many Stokes files have been extracted."""
    expected = ['*.stokesQ.fits', '*.stokesU.fits', '*.freqlist.txt']
    found = 0
    for pat in expected:
        if glob.glob(os.path.join(workdir, pat)):
            found += 1
    return found, len(expected)


def count_chunked_inputs(workdir):
    """How many input chunks have been created in processing/."""
    pattern = os.path.join(workdir, 'processing', 'part_*_*stokesQ.fits')
    return len(glob.glob(pattern))


def count_rmsynth(workdir):
    """How many RM synth output parts exist (FDF_tot_dirty)."""
    pattern = os.path.join(workdir, 'processing', 'part_*_FDF_tot_dirty.fits')
    return len(glob.glob(pattern))


def count_rmclean(workdir):
    """How many RM clean output parts exist (FDF_clean_tot)."""
    pattern = os.path.join(workdir, 'processing', 'part_*_FDF_clean_tot.fits')
    return len(glob.glob(pattern))


def count_merged(workdir):
    """How many merged output cubes exist in the workdir."""
    merged_files = []
    candidates = [
        'FDF_tot_dirty.fits', 'FDF_clean_tot.fits', 'FDF_CC_tot.fits',
        'FDF_im_dirty.fits', 'FDF_real_dirty.fits',
        'FDF_clean_im.fits', 'FDF_clean_real.fits',
        'FDF_CC_im.fits', 'FDF_CC_real.fits',
        'FDF_maxPI.fits', 'FDF_peakRM.fits',
        'RMSF_tot.fits', 'RMSF_im.fits', 'RMSF_real.fits', 'RMSF_FWHM.fits',
    ]
    for f in candidates:
        if os.path.exists(os.path.join(workdir, f)):
            merged_files.append(f)
    return len(merged_files), len(candidates), merged_files


def read_chunks_from_config(workdir):
    """Get the chunks count from config (if it exists) for the denominator."""
    config_files = sorted(glob.glob(os.path.join(workdir, '*.txt')))
    for cfg in config_files:
        try:
            with open(cfg) as f:
                content = f.read()
            m = re.search(r'^chunks\s*=\s*(\d+)', content, re.MULTILINE)
            if m:
                return int(m.group(1))
        except Exception:
            pass
    return 100  # fallback default


